    ctx.fillStyle = Math.random() < .5 ? '#ffd23f' : '#f59e1b'; ctx.fillRect((ship.x | 0) - 1, H - 14, 2, 3 + (Math.random() * 3 | 0));
  }
  pt.forEach(p => { ctx.fillStyle = p.c; ctx.fillRect(p.x | 0, p.y | 0, 2, 2); });
  ctx.fillStyle = '#8bd450'; ctx.fillRect(0, H - 4, W, 4);
  ctx.restore();
}
function loop(t) {
  if (st !== 'play') return;
  const dt = Math.min(.05, (t - last) / 1000); last = t;
  update(dt); if (st === 'play') { draw(); requestAnimationFrame(loop); } else draw();
}

/* ---------- Controles ---------- */
let px0 = 0, sx0 = 0;
cv.addEventListener('pointerdown', e => { if (st !== 'play') return; cv.setPointerCapture(e.pointerId); px0 = e.clientX; sx0 = ship.x; });
cv.addEventListener('pointermove', e => {
  if (st !== 'play') return;
  const r = cv.getBoundingClientRect();
  if (e.pointerType === 'mouse') ship.x = (e.clientX - r.left) / r.width * W;
  else if (e.buttons) ship.x = sx0 + (e.clientX - px0) / r.width * W;
});
addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  if (st === 'play' && ['arrowleft', 'arrowright', ' '].includes(k)) e.preventDefault();
  keys[k] = true;
  if (k === 'p') st === 'play' ? pause() : st === 'pause' && resume();
});
addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });
$('.pi-pause').onclick = () => st === 'play' ? pause() : st === 'pause' && resume();
$('.pi-snd').onclick = e => { mute = !mute; e.currentTarget.innerHTML = mute ? ico.off : ico.on; e.currentTarget.setAttribute('aria-label', mute ? 'Activar sonido' : 'Silenciar'); if (!mute) beep(660, .1); };
document.addEventListener('visibilitychange', () => document.hidden && pause());
new IntersectionObserver(([en]) => { if (!en.isIntersecting) pause(); }, {threshold: .2}).observe(root);

/* ---------- Inicio ---------- */
$('.pi-pause').innerHTML = ico.pause; $('.pi-snd').innerHTML = ico.off;
build(); hud(); draw();
ov('POP INVADERS', 'Las palomitas invaden el espacio. Dispárales antes de que lleguen.', 'JUGAR');
})();
  </script>


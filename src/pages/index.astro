---
import Layout from '../layouts/Layout.astro';
const savory = [
  ['Natural','🌽','4|8|30|95','CLÁSICA'], ['Mantequilla','🧈','5|9|35|105','CLÁSICA'], ['Queso','🧀','7|13|45|115','CLÁSICA'],
  ['Chile','🌶️','7|13|45|115','PICANTE'], ['Ajo & cebolla','🧄','7|13|45|115','ESPECIAL'], ['Especias','✨','7|13|45|115','ESPECIAL'],
  ['Jalapeño','🌶️','7|13|45|115','PICANTE'], ['Esquites','🌽','7|13|45|115','DE LA CASA'], ['Flaming Hot','🔥','7|13|45|115','PICANTE'],
  ['Takis','🌀','7|13|45|115','PICANTE'], ['Limón & pimienta','🍋','7|13|45|115','ESPECIAL'], ['BBQ','🍖','7|13|45|115','ESPECIAL'],
  ['Ranch','🌿','7|13|45|115','ESPECIAL'], ['Habanero','🌶️','7|13|45|115','PICANTE'], ['Parmesano','🧀','7|13|45|115','ESPECIAL']
];
const sweet = [
  ['Caramelo','🍯','8|15|55|120','CLÁSICA'], ['Canela','🤎','9|18|65|200','CLÁSICA'], ['Manzana verde','🍏','9|18|65|200','FRUTAL'],
  ['Cereza','🍒','9|18|65|200','FRUTAL'], ['Uva','🍇','9|18|65|200','FRUTAL'], ['Mora azul','🫐','9|18|65|200','FRUTAL'],
  ['Plátano','🍌','9|18|65|200','FRUTAL'], ['Choco plátano','🍫','9|18|65|200','ESPECIAL'], ['Chocolate','🍫','9|18|65|200','ESPECIAL'],
  ['Fresa','🍓','9|18|65|200','FRUTAL'], ['Piña con chile','🍍','9|18|65|200','ESPECIAL'], ['Pica fresa','🍬','9|18|65|200','ESPECIAL'],
  ['Coco tostado','🥥','9|18|65|200','ESPECIAL'], ['Vainilla','🍦','9|18|65|200','ESPECIAL'], ['Algodón de azúcar','🍭','9|18|65|200','ESPECIAL']
];
const all = [...savory.map((x,i)=>({name:x[0],emoji:x[1],prices:x[2].split('|'),tag:x[3],type:'SALADAS',id:`s${i}`})), ...sweet.map((x,i)=>({name:x[0],emoji:x[1],prices:x[2].split('|'),tag:x[3],type:'DULCES',id:`d${i}`}))];
const sizes = ['CH','MD','G','XL'];
---
<Layout>
  <div class="app-shell">
    <aside class="side-rail" aria-label="Navegación principal">
      <a class="rail-logo" href="#top" aria-label="Inicio de PALOMITASX"><img class="rail-logo-image" src="/palomitasx-logo.png" alt="PALOMITASX" /></a>
      <nav class="rail-nav">
        <a class="rail-link active" href="#top" aria-label="Inicio" title="Inicio"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></a>
        <a class="rail-link" href="#menu" aria-label="Sabores" title="Sabores"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10h14l-2 11H7z"/><path d="M7 9a2.5 2.5 0 1 1 5 0m-1-3a2.5 2.5 0 1 1 5 0m-1 3a2.5 2.5 0 1 1 5 0"/></svg></a>
        <a class="rail-link" href="#paquetes" aria-label="Paquetes" title="Paquetes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18v13H3zM2 4h20v4H2zM12 4v17"/><path d="M12 4H8a2 2 0 1 1 2-2c0 1.1 2 2 2 2Zm0 0h4a2 2 0 1 0-2-2c0 1.1-2 2-2 2Z"/></svg></a>
      </nav>
    </aside>
    <div class="main-wrap">
      <header class="topbar"><span class="topbar-spacer" aria-hidden="true"></span><a class="wordmark" href="#top">PALOMITAS<span>X</span></a><button class="cart-top" id="cart-jump" aria-label="Ver carrito"><svg class="cart-icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M3 5h3l2.5 13.2a2 2 0 0 0 2 1.6h10.8a2 2 0 0 0 1.9-1.4L26 9H7"/><circle cx="12" cy="24" r="1.6"/><circle cx="21" cy="24" r="1.6"/></svg><span class="cart-button-label">CARRITO</span><b id="cart-count">0</b></button></header>
      <main id="top">
        <section class="hero">
          <div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> POP! POP! POP! — HECHO PARA COMPARTIR</div><h1>ELIGE TU<br/><em>ANTOJO.</em></h1><p>Palomitas para fiestas, eventos y todos tus días. Arma tu combo y cotiza en un toque.</p><div class="hero-ctas"><a href="#menu" class="button primary">VER MENÚ <span>↘</span></a><a href="#paquetes" class="text-cta">EXPLORAR PAQUETES <span>↗</span></a></div><div class="hero-stats"><div><b>30</b><small>SABORES</small></div><div><b>02</b><small>UNIVERSOS</small></div><div><b>∞</b><small>BUEN PLAN</small></div></div></div>
          <div class="hero-art" aria-label="Ilustración de una caja de palomitas"><div class="art-sticker">FRESH<br/>DROP<br/><b>★ 01</b></div><div class="burst burst-a">✳</div><div class="burst burst-b">✦</div><div class="popcorn-box"><div class="pops">🍿</div><div class="box-label">POP!<small>PALOMITASX</small></div></div><div class="art-caption">SNACKS<br/><b>WITH ATTITUDE</b></div><div class="art-line"></div></div>
          <div class="hero-foot"><span>01 / 03</span><div class="slider-dots"><i></i><i></i><i></i></div><span>DESLIZA PARA DESCUBRIR ↓</span></div>
        </section>
        <div class="content-grid">
          <section class="catalog" id="menu">
            <div class="section-head"><div><div class="eyebrow red">[ SELECT YOUR FLAVOR ]</div><h2>MENÚ <span>POP!</span></h2></div><div class="size-legend"><small>TAMAÑO</small><span>CH</span><span>MD</span><span>G</span><span>XL</span></div></div>
            <div class="filter-row"><button class="filter active" data-filter="ALL">◈ TODO <small>30</small></button><button class="filter" data-filter="SALADAS">◉ SALADAS <small>15</small></button><button class="filter" data-filter="DULCES">✿ DULCES <small>15</small></button><div class="sort-label">ORDEN: <b>FAVORITOS ↓</b></div></div>
            <div class="flavor-grid" id="flavor-grid">
              {all.map((item, index) => <article class="flavor-card" data-kind={item.type} data-name={item.name.toLowerCase()}>
                <div class={`card-art art-${index % 6}`}><span class="card-code">PX-{String(index+1).padStart(2,'0')}</span><span class="card-emoji">{item.emoji}</span><span class="card-spark">✳</span><button class="quick-add" aria-label={`Agregar ${item.name}`} data-add={item.id}><svg class="plus-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></div>
                <div class="card-info"><div><small>{item.tag}</small><h3>{item.name}</h3></div><span class="kind-tag">{item.type === 'SALADAS' ? 'S' : 'D'}</span></div>
                <div class="card-bottom"><div class="price-line"><span>DESDE</span><b>${item.prices[0]}</b></div><label class="size-select"><span class="sr-only">Tamaño de porción</span><span class="size-label">TAM.</span><select data-size={item.id}>{sizes.map((s,i)=><option value={i}>{s}</option>)}</select><svg class="size-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg></label></div>
                <span class="peso-note">MXN · precio por tamaño</span>
              </article>)}
            </div>
            <section class="packages" id="paquetes"><div class="packages-title"><div><div class="eyebrow">[ PARTY MODE ]</div><h2>PAQUETES <span>PARA COMPARTIR</span></h2></div><span class="pack-count">02 COMBOS DISPONIBLES</span></div><div class="package-grid">
              <article class="package-card"><div class="package-visual pack-yellow">🍿<span>× 6</span></div><div class="package-data"><span class="package-kicker">01 / MINI PARTY</span><h3>Combo Reunión</h3><p>6 bolsas medianas · sabores a elegir</p><b>$180 <small>MXN</small></b></div><button class="add-package" data-pack="Combo Reunión" data-cost="180">AGREGAR +</button></article>
              <article class="package-card featured"><div class="package-visual pack-red">🍿<span>× 12</span></div><div class="package-data"><span class="package-kicker">02 / FULL PARTY</span><h3>Combo Fiesta</h3><p>12 bolsas medianas · sabores a elegir</p><b>$340 <small>MXN</small></b></div><button class="add-package" data-pack="Combo Fiesta" data-cost="340">AGREGAR +</button></article>
            </div><p class="package-note">Combos de muestra editables · pregunta por opciones para eventos y distribución.</p></section>
            <footer><span>PALOMITASX © 2026</span><span>MAÍZ + ACTITUD <b>✳</b></span><span>HECHO PARA HACER POP!</span></footer>
          </section>
          <aside class="cart-panel" id="cart-panel"><div class="cart-heading"><div class="cart-heading-icon" aria-hidden="true"><svg viewBox="0 0 28 28"><path d="M3 5h3l2.5 13.2a2 2 0 0 0 2 1.6h10.8a2 2 0 0 0 1.9-1.4L26 9H7"/><circle cx="12" cy="24" r="1.6"/><circle cx="21" cy="24" r="1.6"/></svg></div><h2>MI CARRITO</h2></div><div class="cart-items" id="cart-items"><div class="empty-cart"><div class="empty-icon">▱</div><b>Tu carrito está vacío</b><small>Elige un sabor para empezar tu misión.</small></div></div><div class="insumo-callout"><span>✳</span><div><b>¿NECESITAS INSUMOS?</b><small>Maíz, aceite, saborizantes y más.</small></div><button id="insumos-wa" aria-label="Cotizar insumos por WhatsApp"><svg class="whatsapp-mini" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 29l6.8-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.1c-1.9 0-3.8-.5-5.4-1.6l-4.4.9 1.2-4.1A10.2 10.2 0 1 1 16 26.3Z"/><path d="M21.6 18.7c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-2.5-1.5 9.1 9.1 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4s-.3-.2-.6-.4Z"/></svg></button></div><div class="cart-total"><span>TOTAL ESTIMADO</span><b id="cart-total">$0 <small>MXN</small></b></div><button class="whatsapp-button" id="checkout"><svg class="whatsapp-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 29l6.8-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.1c-1.9 0-3.8-.5-5.4-1.6l-.4-.2-4 1 1.1-3.9-.3-.4a10.2 10.2 0 1 1 9 5.1Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-2.5-1.5 9.1 9.1 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4s-.3-.2-.6-.4Z"/></svg><span>COTIZAR POR WHATSAPP</span></button><div class="cart-note">PRECIOS DE REFERENCIA · CONFIRMA DISPONIBILIDAD</div><div class="cart-mini"><span aria-hidden="true">🎉</span><b>PEDIDOS PARA EVENTOS Y DISTRIBUCIÓN</b><i aria-hidden="true">✦</i></div></aside>
        </div>
      </main>
    </div>
    <a class="wa-float" id="float-wa" href="#" aria-label="Cotizar por WhatsApp" title="Cotizar por WhatsApp"><svg class="whatsapp-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 29l6.8-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.1c-1.9 0-3.8-.5-5.4-1.6l-.4-.2-4 1 1.1-3.9-.3-.4a10.2 10.2 0 1 1 9 5.1Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-2.5-1.5 9.1 9.1 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4s-.3-.2-.6-.4Z"/></svg></a>
    <div class="toast" id="toast" role="status" aria-live="polite">¡AGREGADO AL CARRITO! ✨</div>
  </div>
  <script type="application/json" id="product-data" set:html={JSON.stringify(all.map(x=>({id:x.id,name:x.name,type:x.type,prices:x.prices.map(Number)})))}></script>
  <script is:inline>
    const cart = new Map();
    const waNumber = '525540402846'; // Cambia este número por el WhatsApp del negocio.
    const products = JSON.parse(document.getElementById('product-data').textContent);
    const money=n=>'$'+Number(n).toLocaleString('es-MX');
    function renderCart(){const host=document.getElementById('cart-items'); let entries=[...cart.values()]; document.getElementById('cart-count').textContent=entries.reduce((s,x)=>s+x.qty,0); if(!entries.length){host.innerHTML='<div class="empty-cart"><div class="empty-icon">▱</div><b>Tu carrito está vacío</b><small>Elige un sabor para empezar tu misión.</small></div>';}else{host.innerHTML=entries.map((x,i)=>`<div class="cart-item"><span class="item-emoji">${x.emoji||'🍿'}</span><div class="item-copy"><b>${x.name}</b><small>${x.detail}</small><div class="qty-controls"><button data-qty="${i}" data-delta="-1">−</button><span>${x.qty}</span><button data-qty="${i}" data-delta="1">+</button></div></div><strong>${money(x.price*x.qty)}</strong></div>`).join('');}document.getElementById('cart-total').innerHTML=money(entries.reduce((s,x)=>s+x.price*x.qty,0))+' <small>MXN</small>';}
    let toastTimer; function toast(label=''){const el=document.getElementById('toast');el.textContent=label?`¡${label} agregado al carrito! ✨`:'¡Agregado al carrito! ✨';el.classList.remove('show');void el.offsetWidth;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
    document.querySelectorAll('.flavor-card').forEach(card=>{const id=card.querySelector('[data-add]').dataset.add;const p=products.find(x=>x.id===id);card.querySelector('.size-select select').dataset.prices=p.prices.join('|');card.querySelector('.size-select select').addEventListener('change',e=>{card.querySelector('.price-line b').textContent=money(p.prices[e.target.value]);});card.querySelector('[data-add]').addEventListener('click',()=>{const size=card.querySelector('select').value;const key=id+'-'+size;const existing=cart.get(key);cart.set(key,{key,name:p.name,detail:['CH','MD','G','XL'][size]+' · '+p.type,price:p.prices[size],qty:(existing?.qty||0)+1,emoji:card.querySelector('.card-emoji').textContent});renderCart();card.querySelector('[data-add]').classList.remove('is-added');void card.querySelector('[data-add]').offsetWidth;card.querySelector('[data-add]').classList.add('is-added');setTimeout(()=>card.querySelector('[data-add]').classList.remove('is-added'),420);toast(p.name);});});
    document.querySelectorAll('.filter').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(b=>b.classList.remove('active'));btn.classList.add('active');document.querySelectorAll('.flavor-card').forEach(card=>card.classList.toggle('hidden',btn.dataset.filter!=='ALL'&&card.dataset.kind!==btn.dataset.filter));}));
    document.querySelectorAll('.add-package').forEach(btn=>btn.addEventListener('click',()=>{const key='pack-'+btn.dataset.pack;const old=cart.get(key);cart.set(key,{key,name:btn.dataset.pack,detail:'Paquete · sabores a elegir',price:Number(btn.dataset.cost),qty:(old?.qty||0)+1,emoji:'🍿'});renderCart();toast(btn.dataset.pack); }));
    document.getElementById('cart-items').addEventListener('click',e=>{const b=e.target.closest('[data-qty]');if(!b)return;const entries=[...cart.values()],item=entries[Number(b.dataset.qty)];item.qty+=Number(b.dataset.delta);if(item.qty<=0)cart.delete(item.key);renderCart();});
    function sendWhatsApp(insumos=false){const entries=[...cart.values()];let message=insumos?'Hola, quiero cotizar insumos para palomitas (maíz, aceite, saborizantes y bolsas).':entries.length?'Hola, quiero cotizar este pedido de PALOMITASX:\n'+entries.map(x=>`• ${x.qty} × ${x.name} (${x.detail}) — ${money(x.price*x.qty)}`).join('\n')+`\n\nTotal estimado: ${money(entries.reduce((s,x)=>s+x.price*x.qty,0))} MXN\n¿Me ayudan a confirmar disponibilidad y precio final?`:'Hola, quiero cotizar palomitas para un evento. ¿Me comparten opciones de sabores y paquetes?';window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`,'_blank','noopener');}
    document.getElementById('checkout').addEventListener('click',()=>sendWhatsApp());document.getElementById('insumos-wa').addEventListener('click',()=>sendWhatsApp(true));document.getElementById('float-wa').addEventListener('click',e=>{e.preventDefault();sendWhatsApp()});document.getElementById('cart-jump').addEventListener('click',()=>document.getElementById('cart-panel').scrollIntoView({behavior:'smooth',block:'center'}));renderCart();
  </script>

</Layout>


---
import Layout from '../layouts/Layout.astro';
const savory = [
  ['Natural','🌽','10|20|60|190','CLÁSICA'], ['Mantequilla','🧈','10|20|70|210','CLÁSICA'], ['Queso','🧀','15|30|90|230','CLÁSICA'],
  ['Chile','🌶️','15|30|90|230','PICANTE'], ['Ajo & cebolla','🧄','15|30|90|230','ESPECIAL'], ['Especias','✨','15|30|90|230','ESPECIAL'],
  ['Jalapeño','🌶️','15|30|90|230','PICANTE'], ['Esquites','🌽','15|30|90|230','DE LA CASA'], ['Flaming Hot','🔥','20|30|90|230','PICANTE'],
  ['Takis','🌀','20|26|90|230','PICANTE']
];
const sweet = [
  ['Caramelo','🍯','18|30|110|240','CLÁSICA'], ['Canela','🤎','20|40|130|400','CLÁSICA'], ['Manzana verde','🍏','18|36|130|400','FRUTAL'],
  ['Cereza','🍒','18|36|130|400','FRUTAL'], ['Uva','🍇','18|36|130|400','FRUTAL'], ['Mora azul','🫐','18|36|130|400','FRUTAL'],
  ['Plátano','🍌','18|36|130|400','FRUTAL'], ['Choco plátano','🍫','18|36|130|400','ESPECIAL'], ['Chocolate','🍫','18|36|130|400','ESPECIAL'],
  ['Fresa','🍓','18|36|130|400','FRUTAL'], ['Piña con chile','🍍','18|36|130|400','ESPECIAL'], ['Pica fresa','🍬','18|36|130|400','ESPECIAL'],
];
const all = [...savory.map((x,i)=>({name:x[0],emoji:x[1],prices:x[2].split('|'),tag:x[3],type:'SALADAS',id:`s${i}`})), ...sweet.map((x,i)=>({name:x[0],emoji:x[1],prices:x[2].split('|'),tag:x[3],type:'DULCES',id:`d${i}`}))];
const sizes = ['CH','MD','G','XL'];
const approximateWeights = [['50 g','70 g'],['100 g','150 g'],['450 g','700 g'],['1.25 kg','2 kg']];
---
<Layout>
  <div class="app-shell">
    <aside class="side-rail" aria-label="Navegación principal">
      <a class="rail-logo" href="#top" aria-label="Inicio de PALOMITASX"><img class="rail-logo-image" src="/palomitasx-logo.png" alt="PALOMITASX" /></a>
      <nav class="rail-nav">
        <a class="rail-link active" href="#top" aria-label="Inicio" title="Inicio"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></a>
        <a class="rail-link" href="#menu" aria-label="Sabores" title="Sabores"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10h14l-2 11H7z"/><path d="M7 9a2.5 2.5 0 1 1 5 0m-1-3a2.5 2.5 0 1 1 5 0m-1 3a2.5 2.5 0 1 1 5 0"/></svg></a>
        <a class="rail-link" href="#paquetes" aria-label="Paquetes" title="Paquetes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18v13H3zM2 4h20v4H2zM12 4v17"/><path d="M12 4H8a2 2 0 1 1 2-2c0 1.1 2 2 2 2Zm0 0h4a2 2 0 1 0-2-2c0 1.1-2 2-2 2Z"/></svg></a>
      </nav>
    </aside>
    <div class="main-wrap">
      <header class="topbar"><span class="topbar-spacer" aria-hidden="true"></span><a class="wordmark" href="#top">POP <span>LAND</span></a><button class="cart-top" id="cart-jump" aria-label="Ver carrito"><svg class="cart-icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M3 5h3l2.5 13.2a2 2 0 0 0 2 1.6h10.8a2 2 0 0 0 1.9-1.4L26 9H7"/><circle cx="12" cy="24" r="1.6"/><circle cx="21" cy="24" r="1.6"/></svg><span class="cart-button-label">CARRITO</span><b id="cart-count">0</b></button></header>
      <main id="top">
        <section class="hero">
          <div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> POP! POP! POP! — HECHO PARA COMPARTIR</div><h1>ELIGE TU<br/><em>ANTOJO.</em></h1><p>Palomitas para fiestas, eventos y todos tus días. Arma tu combo y cotiza en un toque.</p><div class="hero-ctas"><a href="#menu" class="button primary">VER MENÚ <span>↘</span></a><a href="#paquetes" class="text-cta">EXPLORAR PAQUETES <span>↗</span></a></div></div>
          <section class="pi" id="pop-invaders" aria-label="Minijuego: Pop Invaders">
  <header class="pi-head">
    <h2>¡Atrapa las palomitas!</h2>
    <p>Arrastra para mover la nave. Dispara sola.</p>
  </header>
  <div class="pi-hud">
    <span>PUNTOS <b class="pi-s">0000</b></span>
    <span>RÉCORD <b class="pi-h">0000</b></span>
    <span class="pi-l" aria-label="Vidas"></span>
    <span>NIVEL <b class="pi-v">1</b></span>
  </div>
  <div class="pi-screen">
    <canvas class="pi-cv" width="240" height="280" aria-label="Pantalla del juego"></canvas>
    <div class="pi-ov"></div>
  </div>
  <div class="pi-bar">
    <span>Teclado: ← → o A D · P pausa</span>
    <span>
      <button class="pi-ico pi-pause" type="button" aria-label="Pausar"></button>
      <button class="pi-ico pi-snd" type="button" aria-label="Activar sonido"></button>
    </span>
  </div>
</section>
          <div class="hero-foot"><span>01 / 03</span><div class="slider-dots"><i></i><i></i><i></i></div><span>DESLIZA PARA DESCUBRIR ↓</span></div>
        </section>
        <div class="content-grid">
          <section class="catalog" id="menu">
            <div class="section-head"><div><div class="eyebrow red">[ SELECT YOUR FLAVOR ]</div><h2>MENÚ <span>POP!</span></h2></div><div class="size-legend" role="group" aria-label="Tamaño general y gramaje aproximado; saladas y dulces">
              <div class="size-legend-caption"><b>TAMAÑO GENERAL</b><small>GRAMAJE APROXIMADO<br/>SALADAS / DULCES</small></div>
              <div class="size-legend-buttons">{sizes.map((size,i)=><button class={`global-size ${i===0 ? 'active' : ''}`} type="button" data-global-size={i} aria-label={`${size}: saladas ${approximateWeights[i][0]}, dulces ${approximateWeights[i][1]}`} aria-pressed={i===0 ? 'true' : 'false'}><b>{size}</b><small>{approximateWeights[i][0]} / {approximateWeights[i][1]}</small></button>)}</div>
            </div></div>
            <div class="filter-row"><button class="filter active" data-filter="ALL">◈ TODO <small>21</small></button><button class="filter" data-filter="SALADAS">◉ SALADAS <small>9</small></button><button class="filter" data-filter="DULCES">✿ DULCES <small>12</small></button><div class="sort-label">ORDEN: <b>FAVORITOS ↓</b></div></div>
            <div class="flavor-grid" id="flavor-grid">
              {all.map((item, index) => <article class="flavor-card" data-kind={item.type} data-name={item.name.toLowerCase()}>
                <div class={`card-art art-${index % 6}`}><span class="card-code">PX-{String(index+1).padStart(2,'0')}</span><span class="card-emoji">{item.emoji}</span><span class="card-spark">✳</span><button class="quick-add" aria-label={`Agregar ${item.name}`} data-add={item.id}><svg class="plus-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></div>
                <div class="card-info"><div><small>{item.tag}</small><h3>{item.name}</h3></div><span class="kind-tag">{item.type === 'SALADAS' ? 'S' : 'D'}</span></div>
                <div class="card-bottom"><div class="price-line"><span>DESDE</span><b>${item.prices[0]}</b></div><label class="size-select"><span class="sr-only">Tamaño de porción</span><span class="size-label">TAM.</span><select data-size={item.id}>{sizes.map((s,i)=><option value={i}>{s}</option>)}</select><svg class="size-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg></label></div>
                <span class="peso-note">MXN · precio por tamaño</span>
              </article>)}
            </div>
            <section class="packages" id="paquetes"><div class="packages-title"><div><div class="eyebrow">[ PARTY MODE ]</div><h2>PAQUETES <span>PARA COMPARTIR</span></h2></div><span class="pack-count">02 COMBOS DISPONIBLES</span></div><div class="package-grid">
              <article class="package-card"><div class="package-visual pack-yellow">🍿<span>× 6</span></div><div class="package-data"><span class="package-kicker">01 / MINI PARTY</span><h3>Combo Reunión</h3><p>6 bolsas medianas · sabores a elegir</p><b>$180 <small>MXN</small></b></div><button class="add-package" data-pack="Combo Reunión" data-cost="180">AGREGAR +</button></article>
              <article class="package-card featured"><div class="package-visual pack-red">🍿<span>× 12</span></div><div class="package-data"><span class="package-kicker">02 / FULL PARTY</span><h3>Combo Fiesta</h3><p>12 bolsas medianas · sabores a elegir</p><b>$340 <small>MXN</small></b></div><button class="add-package" data-pack="Combo Fiesta" data-cost="340">AGREGAR +</button></article>
            </div><p class="package-note">Combos de muestra editables · pregunta por opciones para eventos y distribución.</p></section>
            <footer><span>POP LAND © 2026</span><span>MAÍZ + ACTITUD <b>✳</b></span><span>HECHO PARA HACER POP!</span></footer>
          </section>
          <aside class="cart-panel" id="cart-panel"><div class="cart-heading"><div class="cart-heading-icon" aria-hidden="true"><svg viewBox="0 0 28 28"><path d="M3 5h3l2.5 13.2a2 2 0 0 0 2 1.6h10.8a2 2 0 0 0 1.9-1.4L26 9H7"/><circle cx="12" cy="24" r="1.6"/><circle cx="21" cy="24" r="1.6"/></svg></div><h2>MI CARRITO</h2></div><div class="cart-items" id="cart-items"><div class="empty-cart"><div class="empty-icon">▱</div><b>Tu carrito está vacío</b><small>Elige un sabor para empezar tu misión.</small></div></div><div class="insumo-callout"><span>✳</span><div><b>¿NECESITAS INSUMOS?</b><small>Maíz, aceite, saborizantes y más.</small></div><button id="insumos-wa" aria-label="Cotizar insumos por WhatsApp"><svg class="whatsapp-mini" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 29l6.8-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.1c-1.9 0-3.8-.5-5.4-1.6l-4.4.9 1.2-4.1A10.2 10.2 0 1 1 16 26.3Z"/><path d="M21.6 18.7c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-2.5-1.5 9.1 9.1 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4s-.3-.2-.6-.4Z"/></svg></button></div><div class="cart-total"><span>TOTAL ESTIMADO</span><b id="cart-total">$0 <small>MXN</small></b></div><button class="whatsapp-button" id="checkout"><svg class="whatsapp-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 29l6.8-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.1c-1.9 0-3.8-.5-5.4-1.6l-.4-.2-4 1 1.1-3.9-.3-.4a10.2 10.2 0 1 1 9 5.1Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-2.5-1.5 9.1 9.1 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4s-.3-.2-.6-.4Z"/></svg><span>COTIZAR POR WHATSAPP</span></button><div class="cart-note">PRECIOS DE REFERENCIA · CONFIRMA DISPONIBILIDAD</div><button class="cart-mini" id="event-order-open" type="button" aria-haspopup="dialog" aria-controls="event-order-dialog"><span aria-hidden="true">🎉</span><b>PEDIDOS PARA EVENTOS ESPECIALES</b><i aria-hidden="true">✦</i></button></aside>
        </div>
        <section class="roulette-section" id="ruleta" aria-labelledby="roulette-title">
          <div class="roulette-intro"><span class="eyebrow">[ UN GIRO · UNA OPORTUNIDAD ]</span><h2 id="roulette-title">RULETA <span>POP!</span></h2><p>Gira una sola vez en este navegador. El premio es aleatorio; probabilidad de ganar: <b>0.1% (1 de cada 1,000 giros)</b>.</p></div>
          <form class="roulette-registration" id="roulette-registration">
            <label for="roulette-name">Escribe tu nombre para participar</label>
            <div class="registration-row"><input id="roulette-name" name="name" autocomplete="name" maxlength="60" placeholder="Tu nombre" required /><button type="submit" class="register-button" id="spin-button">ACEPTAR Y GIRAR ↻</button></div>
            <p class="roulette-form-note">Al aceptar, comenzarás tu único intento en este dispositivo.</p>
          </form>
          <div class="roulette-game"><div class="wheel-wrap"><span class="wheel-pointer" aria-hidden="true">▼</span><div class="roulette-wheel" id="roulette-wheel"><div class="wheel-label label-1">¡POP!</div><div class="wheel-label label-2">CASI</div><div class="wheel-label label-3">YUM</div><div class="wheel-label label-4">SUERTE</div><div class="wheel-label label-5">MANTEQUILLA XL</div><div class="wheel-center">🍿</div></div></div><div class="roulette-controls"><span class="roulette-kicker">5 RESULTADOS · 1 INTENTO POR DISPOSITIVO</span><ul><li>¡Pop!</li><li>Casi, casi</li><li>Palomita feliz</li><li>Otra ronda... algún día</li><li class="prize-option">🎁 Palomitas grandes de mantequilla</li></ul><p class="spin-status" id="spin-status" role="status" aria-live="polite">Escribe tu nombre y acepta para comenzar.</p></div></div>
        </section>
        <dialog class="roulette-result-dialog" id="roulette-result-dialog" aria-labelledby="roulette-result-title">
          <div class="roulette-result-card">
            <span class="result-confetti" aria-hidden="true">✦</span>
            <span class="roulette-result-kicker">RESULTADO OFICIAL · PALOMITASX</span>
            <div class="roulette-result-icon" id="roulette-result-icon" aria-hidden="true">🍿</div>
            <h2 id="roulette-result-title">¡Resultado!</h2>
            <p id="roulette-result-copy"></p>
            <p class="roulette-result-countdown" id="roulette-result-countdown">WhatsApp se abrirá en 5 segundos…</p>
            <button class="share-prize" id="share-prize" hidden>ENVIAR MI PREMIO POR WHATSAPP</button>
          </div>
        </dialog>

        <section class="faq-section" id="preguntas-frecuentes" aria-labelledby="faq-title">
          <div class="faq-heading"><span class="eyebrow red">[ PREGUNTAS POPULARES ]</span><h2 id="faq-title">FAQ <span>POP!</span></h2><p>Lo esencial para que tu evento tenga su dosis de palomitas.</p></div>
          <div class="faq-list">
            <details class="faq-item"><summary>¿A qué lugares hacen entregas?<span aria-hidden="true">+</span></summary><p>La cobertura depende de la zona. Compártenos tu municipio o alcaldía por WhatsApp y confirmamos si llegamos hasta allá.</p></details>
            <details class="faq-item"><summary>¿Con cuántos días de anticipación hago mi pedido?<span aria-hidden="true">+</span></summary><p>Para asegurar sabores y cantidades, te recomendamos cotizar con varios días de anticipación. Para pedidos grandes o fechas concurridas, entre antes nos contactes, mejor.</p></details>
            <details class="faq-item"><summary>¿Cuánto cuesta el envío?<span aria-hidden="true">+</span></summary><p>El costo se confirma según la ubicación y el tamaño del pedido. Envíanos tu municipio o alcaldía para cotizarlo.</p></details>
            <details class="faq-item"><summary>¿Puedo elegir los sabores para mi evento?<span aria-hidden="true">+</span></summary><p>¡Sí! Puedes combinar sabores salados y dulces. Cuéntanos cuántas personas asistirán y te ayudamos a elegir cantidades.</p></details>
            <details class="faq-item"><summary>¿También venden insumos para preparar palomitas?<span aria-hidden="true">+</span></summary><p>Sí, pregunta por disponibilidad de maíz, aceite, saborizantes y otros insumos a través del botón de WhatsApp.</p></details>
          </div>
          <a class="faq-contact" href="https://wa.me/525511931691?text=%F0%9F%8D%BF%20Hola%2C%20tengo%20una%20pregunta%20sobre%20un%20pedido%20de%20PALOMITASX." target="_blank" rel="noopener">¿Te quedó otra duda? Escríbenos por WhatsApp 🍿</a>
        </section>
      </main>
    </div>
    <a class="wa-float" id="float-wa" href="#" aria-label="Cotizar por WhatsApp" title="Cotizar por WhatsApp"><svg class="whatsapp-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 29l6.8-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.1c-1.9 0-3.8-.5-5.4-1.6l-.4-.2-4 1 1.1-3.9-.3-.4a10.2 10.2 0 1 1 9 5.1Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-2.5-1.5 9.1 9.1 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4s-.3-.2-.6-.4Z"/></svg></a>
    <div class="toast" id="toast" role="status" aria-live="polite">¡AGREGADO AL CARRITO! ✨</div>

    <dialog class="welcome-dialog" id="welcome-dialog" aria-labelledby="welcome-title" aria-describedby="welcome-copy">
      <div class="welcome-burst burst-one" aria-hidden="true">✦</div><div class="welcome-burst burst-two" aria-hidden="true">✳</div>
      <div class="welcome-card">
        <button class="welcome-close" id="welcome-close" type="button" aria-label="Cerrar aviso">×</button>
        <span class="welcome-stamp">PALOMITASX · AVISO IMPORTANTE</span>
        <div class="welcome-popcorn" aria-hidden="true">🍿</div>
        <span class="welcome-eyebrow">¡QUE NO TE AGARRE LA HORA!</span>
        <h2 id="welcome-title">Pide con<br/><em>anticipación</em></h2>
        <p id="welcome-copy">Recuerda hacer tu pedido con anticipación 😉 🍿</p>
        <button class="welcome-continue" id="welcome-continue" type="button">¡VA, QUIERO VER EL MENÚ! <span>↘</span></button>
        <small>FIESTA LISTA · PALOMITAS TAMBIÉN</small>
      </div>
    </dialog>
    <dialog class="event-dialog" id="event-order-dialog" aria-labelledby="event-dialog-title">
      <div class="event-dialog-card">
        <button class="event-dialog-close" id="event-order-close" type="button" aria-label="Cerrar cuestionario">×</button>
        <span class="event-kicker">🍿 COTIZACIÓN PARA EVENTOS</span>
        <h2 id="event-dialog-title">¡Planeemos algo especial!</h2>
        <p>Cuéntanos lo básico y te ayudamos a armar tu pedido.</p>
        <form id="event-order-form" class="event-form">
          <label>¿Qué tipo de evento es?
            <select name="eventType" required>
              <option value="" selected disabled>Selecciona una opción</option>
              <option>Cumpleaños</option><option>Boda</option><option>Fiesta infantil</option><option>Evento corporativo</option><option>Reunión familiar</option><option>Otro evento</option>
            </select>
          </label>
          <label>¿En qué municipio o alcaldía será?
            <input name="locality" type="text" autocomplete="address-level2" placeholder="Ej. Coyoacán, CDMX" minlength="2" maxlength="80" required />
          </label>
          <label>¿Qué día será el evento?
            <input name="eventDate" type="date" required />
          </label>
          <label>¿Para cuántas personas aproximadamente?
            <select name="attendees" required>
              <option value="" selected disabled>Selecciona un rango</option>
              <option>Menos de 30</option><option>30 a 60</option><option>61 a 100</option><option>101 a 200</option><option>Más de 200</option><option>Aún no lo sé</option>
            </select>
          </label>
          <button class="event-submit" type="submit"><svg class="whatsapp-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 29l6.8-1.8A12.8 12.8 0 1 0 16 3.2Zm0 23.1c-1.9 0-3.8-.5-5.4-1.6l-.4-.2-4 1 1.1-3.9-.3-.4a10.2 10.2 0 1 1 9 5.1Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-2.5-1.5 9.1 9.1 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4s-.3-.2-.6-.4Z"/></svg>ENVIAR COTIZACIÓN POR WHATSAPP</button>
        </form>
        <small class="event-footnote">Al enviar, se abrirá WhatsApp con tus respuestas listas.</small>
      </div>
    </dialog>
  </div>
  <script type="application/json" id="product-data" set:html={JSON.stringify(all.map(x=>({id:x.id,name:x.name,type:x.type,prices:x.prices.map(Number)})))}></script>
  <script is:inline>
